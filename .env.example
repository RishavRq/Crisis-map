# Crisis Map Frontend — Environment Variables
# Copy this to .env and set your backend URL.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Backend API URL (no trailing slash)
# Local dev:    http://localhost:8080
# Production:   https://your-backend.vercel.app
VITE_API_URL=http://localhost:8080

# Ingestion endpoint secret (used by external scheduler)
# Set this in Vercel dashboard → Settings → Environment Variables
# Then use it in cron-job.org: https://your-app.vercel.app/api/cron/ingest?key=YOUR_SECRET
CRON_SECRET=
