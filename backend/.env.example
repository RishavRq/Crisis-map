# Crisis Map Backend — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Supabase project URL (looks like: https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in client code)
SUPABASE_ANON_KEY=

# Server port (default: 8080)
PORT=8080
